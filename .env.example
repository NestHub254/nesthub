# Backend (Spring Boot / Cloud Run) — never commit real values.
NESTHUB_DB_URL=jdbc:postgresql://HOST:5432/nesthub_staging
NESTHUB_DB_USERNAME=
NESTHUB_DB_PASSWORD=
NESTHUB_JWT_SECRET=
PORT=8080

# Optional: only needed for cross-origin browser calls (not Path B Hosting rewrites).
# NESTHUB_CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Frontend local development (use frontend/.env.local and tenant-portal/.env.local):
# VITE_API_URL=http://localhost:8080
#
# Path B staging/production builds leave VITE_API_URL empty for same-origin /api.
