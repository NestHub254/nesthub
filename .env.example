# Copy to local .env files as needed. Never commit real values.
# Backend (Spring Boot / Cloud Run)
NESTHUB_DB_URL=jdbc:postgresql://HOST:5432/nesthub_staging
NESTHUB_DB_USERNAME=
NESTHUB_DB_PASSWORD=
NESTHUB_JWT_SECRET=
PORT=8080
# Proposed after approval: make CORS env-driven (currently hardcoded to localhost in application.yml)
NESTHUB_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://staging-nesthub.sionaglobal.com

# Frontend builds (Vite)
VITE_API_URL=http://localhost:8080
